# Hydro-1 Academy — teacher keys. Copy to .env and fill in.
# The Academy UI auto-routes keys by prefix; these are the vars it writes.

# OpenRouter (sk-or-v1-…): unlocks z-ai/glm-5.3, glm-5.3-flash, glm-5.2:free
# OPENROUTER_API_KEY=

# NVIDIA NIM (nvapi-…): unlocks deepseek-ai/deepseek-v4-flash-0731
# NVIDIA_API_KEY=

# Any other OpenAI-compatible endpoint (Z.AI etc.) — key without a known prefix
# TEACHER_API_KEY=
# TEACHER_BASE_URL=https://api.z.ai/api/paas/v4

# Optional: full manual roster override (JSON array of teacher entries)
# TEACHER_MODELS=[{"id":"z-ai/glm-5.3","label":"GLM 5.3","base_url":"https://openrouter.ai/api/v1","key_env":"OPENROUTER_API_KEY"}]

# Optional: local fallback teacher endpoint (used when no key is set)
# OLLAMA_BASE=http://localhost:11434
